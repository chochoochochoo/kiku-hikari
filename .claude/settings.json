{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/tools/secret_scan.sh\" --hook"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git commit --no-verify*)",
      "Bash(git push --no-verify*)",
      "Bash(git push -f*)",
      "Bash(git push --force*)",
      "Bash(git commit -n*)",
      "Bash(git push -n*)",
      "Bash(git -c core.hooksPath*)"
    ]
  }
}
