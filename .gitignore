# ---- 秘密値（絶対に入れない）----
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
.netrc
.npmrc
.pypirc
secrets/
credentials*.json
token*.json
*.token

# ---- 実行時キャッシュ（鍵や個人パスが混ざりやすい）----
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.ipynb_checkpoints/
*.ipynb
.cache/
.venv/
venv/
env/
*.egg-info/
build/
dist/

# ---- エディタ・ツールのローカル設定 ----
.vscode/
.idea/
.claude/settings.local.json
.claude/.credentials*
.DS_Store
Thumbs.db
desktop.ini

# ---- 非公開の開発用音源（README「持ち込みデータ」参照）----
music/private/
*.wav
*.mp3
*.flac
!assets/public/*.wav

# ---- 実行ログの生データ（公開するログは logs/public/ に scan 済みのものだけ）----
logs/*
!logs/public/
*.raw
*.sqlite
*.db
.coverage
.coverage.*
